<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <TguiPackageManager Condition="'$(TguiPackageManager)' == ''">pnpm</TguiPackageManager>
  </PropertyGroup>

  <!-- Restore JS dependencies on the first build and after manifest/lock changes.
       The marker is inside node_modules so deleting dependencies also invalidates it. -->
  <Target Name="RestoreTguiDependencies"
          Inputs="$(MSBuildProjectDirectory)/package.json;$(MSBuildProjectDirectory)/pnpm-lock.yaml"
          Outputs="$(MSBuildProjectDirectory)/node_modules/.deeplagoon-restore">
    <Exec Command="$(TguiPackageManager) install --frozen-lockfile" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Touch Files="$(MSBuildProjectDirectory)/node_modules/.deeplagoon-restore" AlwaysCreate="true" />
  </Target>

  <!-- No Inputs/Outputs: every actual build regenerates both production bundles. -->
  <Target Name="BuildTgui" BeforeTargets="BeforeBuild" DependsOnTargets="RestoreTguiDependencies"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Text="DeepLagoon: rebuilding TGUI interface and chat bundles" Importance="high" />
    <Exec Command="$(TguiPackageManager) build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
