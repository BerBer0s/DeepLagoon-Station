ent-GridMagnet = grid magnet
    .desc = A directional welding magnet. Two of them, bolted down on separate grids and facing each other, pull the grids together and weld them into one. It only pulls with its front side.

dl-grid-magnet-verb-on = Switch on
dl-grid-magnet-verb-off = Switch off
dl-grid-magnet-examine-active = It is [color=green]switched on[/color].
dl-grid-magnet-examine-inactive = It is [color=gray]switched off[/color].
dl-grid-magnet-needs-anchor = The magnet has to be bolted down first.
dl-grid-magnet-needs-power = The magnet has no power.
dl-grid-magnet-switched-on = You switch the magnet on.
dl-grid-magnet-switched-off = You switch the magnet off.
dl-grid-magnet-charging = Target locked. The pull starts in { $seconds } s.
dl-grid-magnet-pulling = The grids are being pulled together.
dl-grid-magnet-welding = The grids are touching. Welding in { $seconds } s.
dl-grid-magnet-merged = The grids are welded into one.
dl-grid-magnet-aborted = The pull was interrupted.
dl-grid-magnet-lost-grip = The magnet lost its grip on the grid.
dl-grid-magnet-failed = The grids cannot be welded: { $reason }
dl-grid-magnet-fail-overlap = { $count } tiles of the two grids would overlap.
dl-grid-magnet-fail-too-long = the pull would take too long.
dl-grid-magnet-fail-ftl = a grid is in FTL.
dl-grid-magnet-fail-deed = a grid with a ship deed cannot be merged away.
dl-grid-magnet-fail-stations = the grids belong to different stations.
dl-grid-magnet-fail-docked = another ship is docked to the grid being pulled.
dl-grid-magnet-fail-generic = the merge failed.
