light_mode unshaded;

uniform highp vec2 viewport_size;
uniform highp float rim_width;

void fragment() {
    highp float radius = max(min(viewport_size.x, viewport_size.y) * 0.5 - rim_width, 1.0);
    // Texture UV keeps the reflections fixed to the console when the window moves.
    highp vec2 p = (UV - vec2(0.5)) * viewport_size / radius;
    highp float distance = length(p);
    highp float aa = 1.0 / radius;
    highp float outside = smoothstep(1.0 - aa, 1.0 + aa, distance);

    // Broad upper-left reflection, faint lower-right glint and a soft diagonal sheen.
    highp vec2 upper = (p - vec2(-0.43, -0.68)) / vec2(0.69, 0.39);
    highp vec2 lower = (p - vec2(0.69, 0.43)) / vec2(0.32, 0.54);
    highp float reflection = exp(-dot(upper, upper) * 2.0) * 0.24
        + exp(-dot(lower, lower) * 2.0) * 0.085;
    highp float diagonal = exp(-pow((p.x + p.y * 0.38 + 0.27) / 0.19, 2.0)) * 0.04;
    highp float vignette = smoothstep(0.68, 1.0, distance) * 0.25;
    highp float lip = exp(-pow((distance - 0.988) / (aa * 1.5), 2.0))
        * clamp(0.45 - p.y * 0.4 - p.x * 0.2, 0.0, 1.0) * 0.3;

    highp float glow = reflection + diagonal + lip;
    // Reduce the whole glass effect by 60%, including haze, rim and reflections.
    highp float weight = 0.065 + vignette + glow;
    highp float alpha = weight * 0.4;
    highp vec3 glass = mix(vec3(0.035, 0.11, 0.06), vec3(0.43, 0.68, 0.48),
        glow / max(weight, 0.001));
    // Opaque outside the circle: native geometry and child labels cannot leak through.
    // Match Quasimorph's #070e09 CSS surface in Clyde's linear framebuffer.
    COLOR = zFromSrgb(vec4(mix(glass, vec3(0.027451, 0.054902, 0.035294), outside),
        mix(alpha, 1.0, outside)));
}
