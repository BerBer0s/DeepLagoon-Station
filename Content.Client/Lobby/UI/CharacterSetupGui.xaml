<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         xmlns:style="clr-namespace:Content.Client.Stylesheets"
         xmlns:adaptive="clr-namespace:Content.Client.UserInterface.Controls"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         VerticalExpand="True">
    <Control>
        <PanelContainer Name="BackgroundPanel" />
        <BoxContainer Orientation="Vertical" SeparationOverride="0">
            <BoxContainer Name="Header" Orientation="Horizontal" MinSize="0 40">
                <Label Text="{Loc 'character-setup-gui-character-setup-label'}"
                       Margin="8 0 0 0" VAlign="Center"
                       StyleClasses="LabelHeadingBigger" />

                <adaptive:AdaptiveGridContainer HorizontalExpand="True">
                <Button Name="StatsButton" HorizontalExpand="True"
                        Text="{Loc 'character-setup-gui-character-setup-stats-button'}"
                        StyleClasses="ButtonBig" SetWidth="180" ClipText="True"
                        HorizontalAlignment="Stretch" />
                <cc:CommandButton Name="AdminRemarksButton"
                                  Command="adminremarks"
                                  Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}"
                                  StyleClasses="ButtonBig" SetWidth="180" ClipText="True" />
                <Button Name="RulesButton"
                        Text="{Loc 'character-setup-gui-character-setup-rules-button'}"
                        StyleClasses="ButtonBig" SetWidth="180" ClipText="True"/>
                <Button Name="CharactersToggle" ToggleMode="True" Pressed="True" Text="{Loc 'dl-character-setup-characters'}" ToolTip="{Loc 'dl-character-setup-characters-tooltip'}" StyleClasses="ButtonBig" SetWidth="180" ClipText="True" />
                <Button Name="CloseButton"
                        Access="Public"
                        Text="{Loc 'character-setup-gui-character-setup-close-button'}"
                        StyleClasses="ButtonBig" SetWidth="180" ClipText="True"/>
                </adaptive:AdaptiveGridContainer>
            </BoxContainer>
            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.NanoGold}" ContentMarginTopOverride="2" />
                </PanelContainer.PanelOverride>
            </PanelContainer>
            <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="0">
                <BoxContainer Name="CharEditor" HorizontalExpand="True" />
                <PanelContainer Name="SidebarSeparator" MinSize="2 0">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.NanoGold}" ContentMarginTopOverride="2" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>
                <ScrollContainer Name="CharactersSidebar" MinWidth="220" MaxWidth="220" HScrollEnabled="False" Margin="2 5 0 0">
                    <BoxContainer Name="Characters" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="1" />
                </ScrollContainer>


            </BoxContainer>
        </BoxContainer>
    </Control>
</Control>
